NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pdfpro
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM="PDFPro <no-reply@your-verified-domain.com>"
DEV_EMAIL_OTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PDFPro <no-reply@example.com>"
MAX_FILE_SIZE_MB=25
MAX_TOTAL_UPLOAD_MB=50
MAX_CONCURRENT_UPLOADS=4
# Set to the exact number of trusted reverse-proxy hops in production; keep 0 when directly exposed.
TRUST_PROXY_HOPS=0
TEMP_FILE_TTL_MINUTES=60
OFFICE_CONVERTER_URL=http://127.0.0.1:3101
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
